# Harness runtime state — machine-local, never committed
.claude/state/*
!.claude/state/.gitkeep
!.claude/state/README.md

# Personal Claude Code settings
.claude/settings.local.json

# Local MCP config derived from the example
.mcp.json

# Secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# --- Ecosystem dependency and build output ---------------------------------
# Installed or generated, never authored. The bootstrap story should add
# anything specific to the chosen stack; these are the common ones, present up
# front so that a `pnpm install` or `uv sync` before bootstrap does not bury you
# in untracked files.
#
# This list is also what the phase lock consults: a path git ignores classifies
# as `ignored` rather than `source`, and is writable in every phase. So when a
# tool starts writing somewhere new, add it here in the phase you find it -
# see rules.md.

# Node
node_modules/
.pnpm-store/
.next/
.svelte-kit/
.turbo/
.vitest/
playwright-report/
test-results/
.playwright/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
*.egg-info/

# Rust
target/

# proptest writes a seed file next to the test file whenever a case fails, and
# recommends committing it. Here it is noise: this harness makes every story
# probe its suite by deliberately breaking the implementation, so these files
# record failures of code that was wrong on purpose and are re-run for nothing
# afterwards. Found in MC-003's GREEN, when the mutation probes left one behind
# that the shipped module passes. A genuine counterexample is not lost by this:
# it goes in the story's `## Regressions` and comes back as a named test.
*.proptest-regressions

# Godot
.godot/
*.import

# Build output and coverage
dist/
build/
out/
coverage/
htmlcov/
.coverage

# LLVM coverage counters. `cargo llvm-cov` normally keeps these under
# `target/`, but any test binary built with `-C instrument-coverage` and run
# directly writes `default_*.profraw` into its own working directory - which is
# the crate root, not `target/`. Found in MC-011's RED, measuring AC-6's flake
# rate against an instrumented binary; two of them reached a commit before this
# line existed.
*.profraw
